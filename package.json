{
  "name": "spectorque",
  "version": "0.1.0",
  "description": "Create, inspect and refine agent-ready specifications with traceable evidence.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.20.0"
  },
  "bin": {
    "spectorque": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/core.js",
    "./integrations": "./dist/integration.js"
  },
  "files": [
    "dist",
    "web-dist",
    "skills",
    "integrations",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES",
    "docs",
    "CONSTITUTION.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CITATION.cff",
    "CHANGELOG.md",
    "fixtures"
  ],
  "scripts": {
    "verify:node": "node scripts/verify-node.mjs",
    "browsers:install": "node scripts/install-browsers.mjs",
    "test:browser": "npm run build && playwright test",
    "prepare:codex": "node scripts/prepare-codex.mjs",
    "dev": "npm run build && npm start",
    "start": "node dist/cli.js serve",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "check": "npm run verify:node && npm run test && npm run build",
    "package:integrations": "npm run verify:node && node scripts/package-integrations.mjs",
    "qualify:codex": "node --import tsx scripts/qualify-codex.mjs",
    "test:vscode": "node scripts/test-vscode.mjs",
    "package:vscode": "npm run package:integrations && node scripts/package-vscode.mjs",
    "qualify:handoff": "npm run verify:node && node --import tsx scripts/qualify-common-handoff.mjs",
    "qualify:pi": "npm run verify:node && node scripts/qualify-pi.mjs",
    "qualify:claude": "npm run verify:node && node scripts/qualify-claude.mjs",
    "package:opencode": "npm run verify:node && node scripts/package-opencode.mjs",
    "package:claude": "npm run verify:node && node scripts/package-claude.mjs",
    "qualify:opencode": "npm run verify:node && node scripts/qualify-opencode.mjs",
    "prepare:codex-desktop-probe": "npm run verify:node && node scripts/prepare-codex-desktop-probe.mjs",
    "qualify:codex-desktop-probe": "npm run verify:node && node scripts/qualify-codex-desktop-probe.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "fflate": "^0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.1",
    "tsx": "4.23.15",
    "typescript": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jayanez/spec-torque.git"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "author": {
    "name": "jayanez",
    "url": "https://github.com/jayanez"
  }
}
