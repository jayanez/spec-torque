{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node"],
    "jsx": "react-jsx", "strict": true, "noEmit": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true
  },
  "include": ["src", "tests", "integrations/vscode/src", "integrations/vscode/tests", "vite.config.ts", "playwright.config.ts"]
}
