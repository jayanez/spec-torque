{
  "name": "spectorque",
  "displayName": "SpecTorque",
  "version": "0.3.1",
  "description": "Score agent-ready specifications against 40 EPIC practices with source evidence and reviewed refinements.",
  "publisher": "jayanez",
  "license": "Apache-2.0",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#173f4f",
    "theme": "dark"
  },
  "homepage": "https://github.com/jayanez/spec-torque#readme",
  "bugs": {
    "url": "https://github.com/jayanez/spec-torque/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jayanez/spec-torque.git",
    "directory": "integrations/vscode"
  },
  "keywords": [
    "specification",
    "spec-driven-development",
    "requirements",
    "spec kit",
    "review",
    "ai",
    "agents"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Linters",
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The workbench starts a local server that can apply explicitly reviewed workspace edits. Trust this workspace before opening it."
    },
    "virtualWorkspaces": false
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onCommand:spectorque.review"
  ],
  "contributes": {
    "commands": [
      {
        "command": "spectorque.review",
        "title": "SpecTorque: Open Specification Workbench"
      }
    ]
  }
}
